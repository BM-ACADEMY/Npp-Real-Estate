{
  "requirement": {
    "anchor": "requirement",
    "form_type": "requirement",
    "ga_event": "requirement_submit",
    "title": "Share your requirement",
    "cta": "Share my requirement",
    "wa": "Send it on WhatsApp instead",
    "waMsg": "Hi, I am looking to buy a property in Pondicherry. My budget is ___ and I am looking in ___",
    "note": "We reply within 2 working hours (10 AM – 7 PM, Monday to Saturday).",
    "fields": [
      {
        "name": "name",
        "label": "Your name",
        "type": "text",
        "required": true,
        "autocomplete": "name"
      },
      {
        "name": "phone",
        "label": "WhatsApp or phone number",
        "type": "tel",
        "required": true,
        "autocomplete": "tel",
        "help": "Include your country code if you are outside India."
      },
      {
        "name": "property_type",
        "label": "What are you looking for",
        "type": "select",
        "options": [
          "House site or plot",
          "Independent house or villa",
          "Commercial shop or building",
          "Farmland or larger parcel",
          "A plot in one of our layouts"
        ]
      },
      {
        "name": "area",
        "label": "Preferred area",
        "type": "text",
        "autocomplete": "off"
      },
      {
        "name": "budget",
        "label": "Budget",
        "type": "select",
        "autocomplete": "off",
        "options": [
          "Under ₹25 lakh",
          "₹25 to 50 lakh",
          "₹50 lakh to ₹1 crore",
          "₹1 to 2 crore",
          "Above ₹2 crore"
        ]
      },
      {
        "name": "purpose",
        "label": "Purpose",
        "type": "select",
        "options": [
          "Own use",
          "Investment",
          "Rental income"
        ]
      },
      {
        "name": "timeline",
        "label": "When do you want to register",
        "type": "select",
        "options": [
          "Within a month",
          "One to three months",
          "Three to six months",
          "Just exploring"
        ]
      }
    ]
  },
